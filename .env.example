# ─── Core ────────────────────────────────────────────────────────────────────
APP_NAME=final-project
# APP_VERSION=1.0.0
APP_ENV=local                   # local | development | staging | production
DEBUG=true
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=text                 # text (local) | json (non-local, auto-set)

DOCS_ENABLED=true
ADMIN_BASE_PATH=/admin

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app

# Optional: override pool settings
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# Optional: full URL overrides (takes priority over DB_* above)
# DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# SYNC_DATABASE_URL=postgresql+psycopg2://app:app@localhost:5432/app
# SYNC_DB_DRIVER=postgresql+psycopg2

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
JWT_ISSUER=
JWT_AUDIENCE=

# SESSION_SECRET_KEY=  # falls back to JWT_SECRET_KEY if not set

# Cookie settings
COOKIE_SECURE=false             # set to true in production (HTTPS only)
COOKIE_SAMESITE=Lax
# COOKIE_DOMAIN=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list or JSON array
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Pagination ───────────────────────────────────────────────────────────────
PAGINATION_DEFAULT_PAGE=1
PAGINATION_DEFAULT_PAGE_SIZE=20
PAGINATION_MAX_PAGE_SIZE=100

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_ENABLED=false
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENV=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.0
# SENTRY_SEND_PII=false
# SENTRY_RELEASE=